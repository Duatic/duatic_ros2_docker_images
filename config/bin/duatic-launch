# duatic-launch: `ros2 launch`, with its output also copied to the host journal.
#
# Takes the arguments of `ros2 launch`. Each line is sent to the syslog socket at /dev/log
# under the tag duatic-launch, with the priority of its ROS severity, so on the host
#   journalctl -t duatic-launch -p err
# lists the errors. Without that socket the launch runs unchanged.

set -o pipefail

if [ ! -S /dev/log ]; then
    echo "duatic-launch: no /dev/log here, the output is not copied to the journal" >&2
    exec ros2 launch "$@"
fi

# The syslog priority of a line, from the severity ROS prints at its start or after the
# process name launch puts in front. Colour codes are removed first.
PRIORITY_PREFIX='
s/\x1b\[[0-9;]*m//g
/(^|\] )\[FATAL\] \[/{s/^/<2>/;b}
/(^|\] )\[ERROR\] \[/{s/^/<3>/;b}
/(^|\] )\[WARN(ING)?\] \[/{s/^/<4>/;b}
/(^|\] )\[DEBUG\] \[/{s/^/<7>/;b}
s/^/<6>/
'

# Ctrl-C reaches every process here. Only the launch may act on it: the others have to
# stay up to carry its shutdown output.
ros2 launch "$@" 2>&1 |
    tee -i >(
        trap '' INT
        sed -u -E "$PRIORITY_PREFIX" | logger --prio-prefix -t duatic-launch
    )
status=$?
wait
exit "$status"
